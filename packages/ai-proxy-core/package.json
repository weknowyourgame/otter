{
	"name": "ai-proxy-core",
	"private": true,
	"version": "0.1.0",
	"description": "Shared OpenRouter-calling logic for the AI widget's backend contract. Consumed by packages/server and apps/landing — not a standalone service.",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": ["dist"],
	"scripts": {
		"build": "node scripts/build.mjs && tsc -p tsconfig.json --emitDeclarationOnly --outDir dist"
	},
	"devDependencies": {
		"esbuild": "^0.21.0",
		"typescript": "^5.6.3"
	}
}
