{
	"name": "otter-sdk",
	"version": "0.1.0",
	"private": true,
	"description": "Otter — the embeddable AI support agent that completes the task instead of explaining it. One script tag: chat widget + a consent-gated executor that drives your app's UI with a visible cursor.",
	"type": "module",
	"main": "dist/otter-sdk.esm.js",
	"module": "dist/otter-sdk.esm.js",
	"types": "dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/otter-sdk.esm.js",
			"default": "./dist/otter-sdk.esm.js"
		},
		"./loader": "./dist/otter-loader.global.js",
		"./widget": "./dist/otter-widget.global.js"
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "node scripts/build.mjs && tsc -p tsconfig.json --emitDeclarationOnly --outDir dist/types",
		"dev": "node scripts/build.mjs --watch"
	},
	"devDependencies": {
		"esbuild": "^0.28.1",
		"typescript": "^5.6.3"
	}
}
