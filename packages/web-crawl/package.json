{
	"name": "otter-web-crawl",
	"private": true,
	"version": "0.1.0",
	"description": "Shared website crawl ingestion processor for local BullMQ workers and Cloudflare-triggered API jobs.",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc -p tsconfig.json --outDir dist"
	},
	"dependencies": {
		"otter-core": "workspace:*",
		"otter-db": "workspace:*"
	},
	"devDependencies": {
		"typescript": "^5.6.3"
	}
}
