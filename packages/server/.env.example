# Optional. Get a free key at openrouter.ai/keys.
# Without this, the widget still works using its local keyword matcher —
# real AI matching just won't be available.
OPENROUTER_API_KEY=sk-or-...

# Required for the Jira Service Management demo webhook. Any long random
# string; the same value goes in the Jira Automation rule's
# x-guidance-demo-secret header. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JIRA_AUTOMATION_SECRET=

# Where handoff links in Jira comments point — the demo SaaS app's base URL
# (the Next.js example). Defaults to http://localhost:3000 if unset.
DEMO_APP_URL=http://localhost:3000
