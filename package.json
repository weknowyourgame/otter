{
	"name": "ai-widget-monorepo",
	"private": true,
	"version": "0.1.0",
	"workspaces": [
		"packages/*",
		"examples/*",
		"apps/*"
	],
	"scripts": {
		"build": "npm run build --workspace=packages/ai-proxy-core && npm run build --workspace=packages/sdk",
		"server": "npm start --workspace=packages/server",
		"example": "npm run dev --workspace=examples/nextjs-loginwithchatgpt",
		"landing": "npm run dev --workspace=apps/landing",
		"test": "npm test --workspace=packages/server && node packages/sdk/test/handoff.e2e.mjs"
	}
}
