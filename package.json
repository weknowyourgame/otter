{
	"name": "ai-widget-monorepo",
	"private": true,
	"version": "0.1.0",
	"workspaces": [
		"packages/*",
		"apps/*"
	],
	"scripts": {
		"build": "bun run --cwd packages/core build && bun run --cwd packages/sdk build",
		"dev": "NEXT_DIST_DIR=.next-main bun run --cwd apps/web dev",
		"landing": "NEXT_DIST_DIR=.next-main bun run --cwd apps/landing dev"
	}
}
