{
	"name": "ai-widget-monorepo",
	"private": true,
	"version": "0.1.0",
	"workspaces": [
		"packages/*",
		"apps/*"
	],
	"scripts": {
		"build": "bun run --cwd packages/core build && bun run --cwd packages/sdk build",
		"dev": "NEXT_DIST_DIR=.next-main bun run --cwd apps/web dev",
		"dev:all": "bun run scripts/dev-all.ts",
		"dev:landing": "NEXT_DIST_DIR=.next-main bun run --cwd apps/landing dev -- -p 3000",
		"dev:web": "NEXT_DIST_DIR=.next-main bun run --cwd apps/web dev -- -p 3001",
		"landing": "NEXT_DIST_DIR=.next-main bun run --cwd apps/landing dev",
		"api": "bun run --cwd apps/api dev",
		"workers": "bun run --cwd apps/workers dev",
		"lint": "biome check .",
		"changeset": "changeset",
		"check:embed-size": "bun run scripts/checks/browser-embed-size.ts",
		"prepare-package": "bun run scripts/prepare-package.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "2.2.6",
		"@changesets/cli": "^2.29.8",
		"@commitlint/cli": "^19.8.1",
		"@commitlint/config-conventional": "^19.8.1"
	}
}
