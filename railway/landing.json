{
	"$schema": "https://railway.com/railway.schema.json",
	"build": {
		"builder": "RAILPACK",
		"buildCommand": "NEXT_DIST_DIR=.next-main bun run --cwd apps/landing build",
		"watchPatterns": ["apps/landing/**", "package.json", "bun.lock"]
	},
	"deploy": {
		"startCommand": "NEXT_DIST_DIR=.next-main bun run --cwd apps/landing start",
		"healthcheckPath": "/health",
		"healthcheckTimeout": 300,
		"restartPolicyType": "ON_FAILURE",
		"restartPolicyMaxRetries": 3
	}
}
