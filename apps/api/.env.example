DATABASE_URL=postgres://localhost:5432/otter
BETTER_AUTH_URL=http://localhost:8787
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
OTTER_API_KEY_SECRET=replace-with-a-different-32-character-secret
OTTER_DASHBOARD_ORIGINS=http://localhost:3001

OPENROUTER_API_KEY=
REDIS_URL=redis://127.0.0.1:6379

# Optional: production web-crawl queue backend. Leave unset for local BullMQ.
# In Cloudflare mode, the API processes crawl jobs after the Cloudflare Queue
# consumer calls /internal/web-crawl/process.
WEB_CRAWL_BACKEND=
CLOUDFLARE_WEB_CRAWL_ENQUEUE_URL=http://localhost:8790/enqueue
OTTER_WORKER_SECRET=
FIRECRAWL_API_KEY=
FIRECRAWL_CRAWL_LIMIT=50
FIRECRAWL_MAX_CONCURRENCY=2
FIRECRAWL_ALLOW_SUBDOMAINS=0

# Required for email verification + password reset to actually send. Without
# it, both flows work but just log the link to the server console instead of
# emailing it — fine for local dev, not for real signups.
RESEND_API_KEY=
EMAIL_FROM=Otter <onboarding@resend.dev>
