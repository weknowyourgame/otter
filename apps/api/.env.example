DATABASE_URL=postgres://localhost:5432/otter
BETTER_AUTH_URL=http://localhost:8787
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
OTTER_API_KEY_SECRET=replace-with-a-different-32-character-secret
OTTER_DASHBOARD_ORIGINS=http://localhost:3001

OPENROUTER_API_KEY=
AGENT_MODEL=anthropic/claude-sonnet-4.5
REDIS_URL=redis://127.0.0.1:6379

# Required for email verification + password reset to actually send. Without
# it, both flows work but just log the link to the server console instead of
# emailing it — fine for local dev, not for real signups.
RESEND_API_KEY=
EMAIL_FROM=Otter <onboarding@resend.dev>
