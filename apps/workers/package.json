{
	"name": "otter-workers",
	"private": true,
	"version": "0.1.0",
	"description": "Background job processor. Currently: web-crawl (crawl a website via Firecrawl, chunk discovered pages, embed each chunk, store searchable knowledge in otter-db).",
	"type": "module",
	"scripts": {
		"dev": "bun run --hot src/index.ts",
		"dev:cloudflare": "wrangler dev --config wrangler.toml --local --port 8790",
		"deploy:cloudflare": "wrangler deploy --config wrangler.toml",
		"start": "bun run src/index.ts",
		"test": "bun test"
	},
	"dependencies": {
		"bullmq": "^5.34.4",
		"otter-jobs": "workspace:*",
		"otter-redis": "workspace:*",
		"otter-web-crawl": "workspace:*"
	},
	"devDependencies": {
		"@types/bun": "^1.2.11",
		"typescript": "^5.6.3",
		"wrangler": "^4.114.0"
	}
}
